  <disable_collisions link1="AR5-5_07L-W4C4A2_link5" link2="AR5-5_07L-W4C4A2_link7" reason="Never"/>
  <disable_collisions link1="AR5-5_07R-W4C4A2_link5" link2="AR5-5_07R-W4C4A2_link7" reason="Never"/>


  <disable_collisions link1="arm_base_link" link2="AR5-5_07R-W4C4A2_base" reason="Adjacent"/>
