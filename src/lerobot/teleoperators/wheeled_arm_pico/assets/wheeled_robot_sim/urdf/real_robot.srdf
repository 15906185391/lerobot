<?xml version="1.0"?>
<robot name="real_robot">
  <group name="left_arm">
    <chain base_link="arm_base_link" tip_link="AR5-5_07L-W4C4A2_tcp"/>
  </group>
  <group name="right_arm">
    <chain base_link="arm_base_link" tip_link="AR5-5_07R-W4C4A2_tcp"/>
  </group>
  <group name="dual_arm">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>

  <disable_collisions link1="torso" link2="neck_yaw_link" reason="Adjacent"/>
